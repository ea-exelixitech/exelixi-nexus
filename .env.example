# development | production
VITE_APP_ENV=production

# Base path Vite (cierrelmds + Apache strip /admin → :5200/)
# Producción: ./ o /admin/ (equivale a ./). No usar base /admin/ en Vite (bucle 302).
# El build inyecta <base href="/admin/"> para assets en /admin/empresas/…
VITE_APP_BASE=./

# URL de exelixi-nexus-services (proxy dev/preview de /api)
# Local:     http://localhost:3092
# cierrelmds: https://cierrelmds.exelixitech.com/nexus-api
VITE_API_URL=http://localhost:3092

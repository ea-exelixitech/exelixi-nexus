# development | production
VITE_APP_ENV=production

# Base path Vite (prefijo HTTPS en cierrelmds)
# Local dev: omitir o /
# Build prod cierrelmds: /admin/  (obligatorio para rutas /admin/empresas/…)
VITE_APP_BASE=/admin/

# URL de exelixi-nexus-services (proxy dev/preview de /api)
# Local:     http://localhost:3092
# cierrelmds: https://cierrelmds.exelixitech.com/nexus-api
VITE_API_URL=http://localhost:3092
